<Window x:Class="AlienPomodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="INTERFACE 2037 // POMODORO"
        Width="820" Height="600" MinWidth="680" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#FF000000" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <!-- Outer bezel -->
    <Border Background="#FF0A0A0A" BorderBrush="#FF2A2A2A" BorderThickness="10" Padding="6">
        <Border Background="{StaticResource Screen}" BorderBrush="{StaticResource PhosphorDim}"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Content -->
                <Grid Margin="28,14,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- chrome / title -->
                        <RowDefinition Height="Auto"/>  <!-- tally -->
                        <RowDefinition Height="Auto"/>  <!-- divider -->
                        <RowDefinition Height="*"/>     <!-- timer -->
                        <RowDefinition Height="Auto"/>  <!-- progress -->
                        <RowDefinition Height="Auto"/>  <!-- buttons -->
                        <RowDefinition Height="Auto"/>  <!-- log -->
                    </Grid.RowDefinitions>

                    <!-- Title bar (draggable) -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Term}" FontSize="13" Text="INTERFACE 2037 READY FOR INQUIRY"/>
                            <TextBlock x:Name="ClockText" Style="{StaticResource Term}" FontSize="13"
                                       Foreground="{StaticResource PhosphorDim}" Effect="{x:Null}" Margin="24,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ChromeButton}" Content="_" Click="Minimize_Click" ToolTip="Minimize"/>
                            <Button Style="{StaticResource ChromeButton}" Content="X" Click="Close_Click" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tally of completed sessions -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Term}" FontSize="12" VerticalAlignment="Center"
                                   Text="CYCLES&#x0a;LOGGED" Margin="0,0,14,0"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource PhosphorDim}" BorderThickness="1"
                                MinHeight="48" Padding="10,6">
                            <Grid>
                                <WrapPanel x:Name="TallyPanel" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TallyEmptyText" Style="{StaticResource Term}" FontSize="12"
                                           Foreground="{StaticResource PhosphorDim}" Effect="{x:Null}"
                                           VerticalAlignment="Center" Text="-- NO CYCLES LOGGED THIS DAY --"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TallyCountText" Grid.Column="2" Style="{StaticResource Term}"
                                   FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="14,0,0,0" Text="00"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource Term}" FontSize="12" Margin="0,10,0,0"
                               Foreground="{StaticResource PhosphorDim}" Effect="{x:Null}"
                               TextTrimming="None" ClipToBounds="True"
                               Text="================================================================================================================================"/>

                    <!-- Main readout -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PhaseText" Style="{StaticResource Term}" FontSize="20"
                                   HorizontalAlignment="Center" Text="STATUS: STANDBY"/>
                        <Viewbox MaxHeight="190" Margin="0,6">
                            <TextBlock x:Name="TimerText" Style="{StaticResource Term}" FontWeight="Bold"
                                       FontSize="140" Text="25:00">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource PhosphorColor}"
                                                      BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Viewbox>
                        <TextBlock x:Name="SubText" Style="{StaticResource Term}" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="{StaticResource PhosphorDim}"
                                   Effect="{x:Null}" Text="25 MIN WORK CYCLE  //  05 MIN REST CYCLE"/>
                    </StackPanel>

                    <!-- Block progress bar -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,18">
                        <Border x:Name="ProgressFrame" BorderBrush="{StaticResource Phosphor}" BorderThickness="1"
                                Padding="3" Width="460" Height="20">
                            <UniformGrid x:Name="ProgressCellsPanel" Rows="1"/>
                        </Border>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Term}" FontSize="15"
                                   VerticalAlignment="Center" Width="56" TextAlignment="Right" Text="0%"/>
                    </StackPanel>

                    <!-- Controls -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource TermButton}" Content="[ INITIATE ]"
                                Click="Start_Click" ToolTip="Start a pomodoro (Enter)"/>
                        <Button x:Name="PauseButton" Style="{StaticResource TermButton}" Content="[ HOLD ]"
                                Click="Pause_Click" IsEnabled="False" ToolTip="Pause / resume (Space)"/>
                        <Button x:Name="AbortButton" Style="{StaticResource TermButton}" Content="[ ABORT ]"
                                Click="Abort_Click" IsEnabled="False" ToolTip="Abort session (Esc)"/>
                    </StackPanel>

                    <!-- Terminal log -->
                    <Border Grid.Row="6" Margin="0,16,0,0" BorderBrush="{StaticResource PhosphorDim}"
                            BorderThickness="0,1,0,0" Padding="0,8,0,0" Height="78">
                        <TextBlock x:Name="LogText" Style="{StaticResource Term}" FontSize="13"
                                   TextWrapping="NoWrap" VerticalAlignment="Bottom"/>
                    </Border>
                </Grid>

                <!-- CRT scanlines -->
                <Rectangle IsHitTestVisible="False" Opacity="0.35">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute"
                                      Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H4 V4 H0 Z"/>
                                    <GeometryDrawing Brush="#FF000000" Geometry="M0,2 H4 V4 H0 Z"/>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Vignette -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Color="#00000000" Offset="0.55"/>
                            <GradientStop Color="#C0000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Flicker layer (animated in code) -->
                <Rectangle x:Name="FlickerLayer" IsHitTestVisible="False" Fill="{StaticResource Phosphor}" Opacity="0"/>
            </Grid>
        </Border>
    </Border>
</Window>
