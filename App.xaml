<Application x:Class="AlienPomodoro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Phosphor palette -->
        <Color x:Key="PhosphorColor">#FF5CFF7A</Color>
        <Color x:Key="PhosphorDimColor">#FF1F6B33</Color>
        <Color x:Key="AmberColor">#FFFFB347</Color>
        <SolidColorBrush x:Key="Phosphor" Color="{StaticResource PhosphorColor}"/>
        <SolidColorBrush x:Key="PhosphorDim" Color="{StaticResource PhosphorDimColor}"/>
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
        <SolidColorBrush x:Key="Screen" Color="#FF020A04"/>

        <DropShadowEffect x:Key="Glow" Color="{StaticResource PhosphorColor}"
                          BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="AmberGlow" Color="{StaticResource AmberColor}"
                          BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>

        <FontFamily x:Key="TermFont">Consolas, Lucida Console, Courier New</FontFamily>

        <Style TargetType="TextBlock" x:Key="Term">
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Phosphor}"/>
            <Setter Property="Effect" Value="{StaticResource Glow}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Terminal-style bracket button -->
        <Style TargetType="Button" x:Key="TermButton">
            <Setter Property="FontFamily" Value="{StaticResource TermFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Phosphor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Phosphor}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource PhosphorColor}"
                                                  BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Phosphor}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Screen}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ChromeButton" BasedOn="{StaticResource TermButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
